    "Train string accuracy, alternate picking, crossing, and fast flatpick control.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena la precisión entre cuerdas, la púa alternada, los cruces y el control rápido de la púa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaillez la précision entre les cordes, l’aller-retour, les changements de corde et le contrôle rapide du médiator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe Saitengenauigkeit, Wechselschlag, Saitenwechsel und schnelle Kontrolle des Plektrums."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allena la precisione sulle corde, la pennata alternata, i cambi di corda e il controllo rapido del plettro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treine a precisão nas cordas, a palhetada alternada, as trocas de corda e o controle rápido da palheta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Train snaarnauwkeurigheid, alternate picking, snaarwissels en snelle plectrumcontrole."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz precyzję strun, kostkowanie naprzemienne, zmiany strun i szybką kontrolę kostki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируйте точность по струнам, переменный штрих, переходы между струнами и контроль медиатора на скорости."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуйте точність по струнах, змінний штрих, переходи між струнами й швидкий контроль медіатора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel doğruluğunu, alternate pena vuruşunu, tel geçişlerini ve hızlı pena kontrolünü çalışın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درّب دقة العزف على الأوتار والعزف المتناوب وتبديل الأوتار والتحكم السريع بالريشة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגלו דיוק במעבר בין מיתרים, פריטה לסירוגין, חציית מיתרים ושליטה מהירה במפרט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारों पर सटीकता, बारी-बारी से पिकिंग, तार बदलना और तेज़ पिक नियंत्रण का अभ्यास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তার নির্ভুলতা, পালাক্রমে পিকিং, তার বদল এবং দ্রুত পিক নিয়ন্ত্রণ অনুশীলন করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاروں کی درستگی، باری باری پکنگ، تار بدلنے اور تیز پلیکٹرم کنٹرول کی مشق کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih ketepatan senar, petikan bergantian, perpindahan senar, dan kendali pick yang cepat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện độ chính xác khi chuyển dây, cách gảy luân phiên, đổi dây và điều khiển miếng gảy nhanh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกความแม่นยำของสาย การดีดสลับ การข้ามสาย และการควบคุมปิ๊กอย่างรวดเร็ว"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弦の正確さ、オルタネイトピッキング、弦移動、速いピックさばきを鍛えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄 정확도, 얼터네이트 피킹, 줄 이동, 빠른 피크 조절을 연습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练弦间准确度、交替拨弦、换弦以及快速控制拨片的能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訓練弦間準確度、交替撥弦、換弦以及快速控制撥片的能力。"
          }
        }
      }
    },
