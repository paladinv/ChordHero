    "Learn about Chord Hero and its approach.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conoce Chord Hero y su método."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez Chord Hero et sa méthode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne Chord Hero und die Methode kennen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri Chord Hero e il suo metodo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheça o Chord Hero e seu método."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek Chord Hero en de aanpak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj Chord Hero i jego podejście."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте о Chord Hero и его подходе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дізнайтеся про Chord Hero та його підхід."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero'yu ve yaklaşımını tanı."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرّف على Chord Hero ونهجه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכירו את Chord Hero ואת הגישה שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero और इसकी पद्धति जानें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero ও এর পদ্ধতি সম্পর্কে জানুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero اور اس کے طریقۂ کار کو جانیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenali Chord Hero dan pendekatannya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm hiểu Chord Hero và phương pháp này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำความรู้จัก Chord Hero และแนวทางของแอป"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero とその練習方法を紹介します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero와 연습 방식을 알아보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解 Chord Hero 及其练习方法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "了解 Chord Hero 與它的練習方法。"
          }
        }
      }
    },
    "Built to make chord changes feel effortless.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseñado para cambiar de acorde sin esfuerzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enchaîner les accords sans effort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit sich Akkordwechsel mühelos anfühlen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rendere naturali i cambi di accordo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito para tornar as trocas de acordes naturais."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akkoorden wisselen zonder moeite."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zmiany akordów przychodziły bez wysiłku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы смена аккордов давалась легко."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб зміна акордів давалася легко."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akor geçişlerini zahmetsiz hâle getirmek için."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لجعل الانتقال بين الأوتار سهلًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי שמעברי אקורדים ירגישו טבעיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि कॉर्ड बदलना सहज लगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কর্ড পরিবর্তনকে সহজ করে তুলতে তৈরি।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاکہ کورڈ بدلنا آسان محسوس ہو۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirancang agar perpindahan akor terasa mudah."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp việc chuyển hợp âm trở nên nhẹ nhàng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกแบบมาให้เปลี่ยนคอร์ดได้อย่างเป็นธรรมชาติ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードチェンジを自然にするために。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 전환을 자연스럽게 만들기 위해."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让和弦转换变得轻松自然。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓和弦轉換變得輕鬆自然。"
          }
        }
      }
    },
    "Chord Hero is a focused practice companion for guitarists who want to switch chords faster, cleaner, and with more confidence.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero es un compañero de práctica para guitarristas que quieren cambiar de acorde con más rapidez, limpieza y confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero accompagne les guitaristes qui veulent enchaîner les accords plus vite, plus proprement et avec davantage d’assurance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero unterstützt Gitarristinnen und Gitarristen dabei, Akkorde schneller, sauberer und sicherer zu wechseln."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero è un compagno di pratica per chi vuole cambiare accordo più velocemente, con più precisione e sicurezza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero é um companheiro de prática para guitarristas que querem trocar acordes com mais rapidez, precisão e confiança."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero helpt gitaristen akkoorden sneller, zuiverder en met meer vertrouwen te wisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero pomaga gitarzystom zmieniać akordy szybciej, czyściej i z większą pewnością."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero помогает гитаристам менять аккорды быстрее, чище и увереннее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero допомагає гітаристам змінювати акорди швидше, чистіше й упевненіше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero, akorları daha hızlı, temiz ve güvenle değiştirmek isteyen gitaristler için bir çalışma arkadaşıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero رفيق تدريب لعازفي الغيتار الراغبين في تبديل الأوتار بسرعة ونظافة وثقة أكبر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero עוזרת לגיטריסטים לעבור בין אקורדים מהר יותר, נקי יותר ובביטחון רב יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero उन गिटारवादकों के लिए अभ्यास साथी है जो कॉर्ड तेज़ी से, साफ़ और आत्मविश्वास से बदलना चाहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero গিটারবাদীদের দ্রুত, পরিষ্কার ও আত্মবিশ্বাসের সঙ্গে কর্ড বদলানোর অনুশীলনে সাহায্য করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero گٹار بجانے والوں کے لیے مشق کا ساتھی ہے جو کورڈ تیزی، صفائی اور اعتماد سے بدلنا چاہتے ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero adalah teman latihan bagi gitaris yang ingin berpindah akor lebih cepat, bersih, dan percaya diri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero đồng hành cùng người chơi guitar muốn chuyển hợp âm nhanh hơn, sạch hơn và tự tin hơn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero เป็นผู้ช่วยฝึกกีตาร์สำหรับผู้ที่อยากเปลี่ยนคอร์ดได้เร็ว สะอาด และมั่นใจยิ่งขึ้น"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero は、コードをより速く、きれいに、自信を持って切り替えたいギタリストのための練習パートナーです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero는 코드를 더 빠르고 정확하게, 자신 있게 바꾸려는 기타 연주자를 위한 연습 도우미입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero 是一款专注的吉他练习伙伴，帮助你更快、更干净、更自信地转换和弦。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Chord Hero 是一款專注的吉他練習夥伴，幫助你更快、更乾淨、更有自信地轉換和弦。"
          }
        }
      }
    },
    "Short loops turn deliberate movement into dependable muscle memory.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ciclos breves convierten el movimiento deliberado en memoria muscular fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De courtes boucles transforment un geste réfléchi en mémoire musculaire fiable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Übungsschleifen machen bewusste Bewegungen zu verlässlichem Muskelgedächtnis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Brevi cicli trasformano i movimenti intenzionali in memoria muscolare affidabile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclos curtos transformam movimentos intencionais em memória muscular confiável."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte herhalingen maken bewuste bewegingen tot betrouwbaar spiergeheugen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótkie pętle zamieniają świadomy ruch w niezawodną pamięć mięśniową."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткие циклы превращают осознанные движения в надёжную мышечную память."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткі цикли перетворюють усвідомлені рухи на надійну м’язову пам’ять."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa döngüler, bilinçli hareketleri güvenilir kas hafızasına dönüştürür."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحوّل الحلقات القصيرة الحركة الواعية إلى ذاكرة عضلية موثوقة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לולאות קצרות הופכות תנועה מכוונת לזיכרון שריר אמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे अभ्यास चक्र सोच-समझकर की गई गति को भरोसेमंद मांसपेशी-स्मृति में बदलते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছোট অনুশীলন-চক্র সচেতন নড়াচড়াকে নির্ভরযোগ্য পেশিস্মৃতিতে পরিণত করে।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مختصر مشقیں سوچ سمجھ کر کی گئی حرکت کو قابلِ اعتماد عضلاتی یادداشت میں بدل دیتی ہیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latihan singkat mengubah gerakan sadar menjadi memori otot yang andal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các vòng luyện tập ngắn biến chuyển động có chủ đích thành trí nhớ cơ bắp đáng tin cậy."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การฝึกเป็นช่วงสั้น ๆ เปลี่ยนการเคลื่อนไหวอย่างตั้งใจให้เป็นความจำของกล้ามเนื้อที่เชื่อถือได้"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い反復練習で、意識した動きを確かな筋肉の記憶に変えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 반복 연습은 의식적인 움직임을 믿을 수 있는 근육 기억으로 바꿉니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短循环练习能把有意识的动作转化为可靠的肌肉记忆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短循環練習能將有意識的動作轉化為可靠的肌肉記憶。"
          }
        }
      }
    },
