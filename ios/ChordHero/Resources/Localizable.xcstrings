    "Find a shape, hear it, and focus on one task at a time.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra una posición, escúchala y céntrate en una tarea cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez une position, écoutez-la et concentrez-vous sur une tâche à la fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde einen Griff, höre ihn an und konzentriere dich auf eine Aufgabe nach der anderen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova una posizione, ascoltala e concentrati su un compito alla volta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre uma posição, ouça e concentre-se em uma tarefa por vez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek een greep, beluister hem en focus op één taak tegelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź chwyt, odsłuchaj go i skup się na jednym zadaniu naraz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите аппликатуру, прослушайте её и сосредоточьтесь на одной задаче за раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть аплікатуру, прослухайте її та зосередьтеся на одному завданні за раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şekil bulun, dinleyin ve her seferinde tek bir göreve odaklanın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على شكل، واستمع إليه، وركّز على مهمة واحدة في كل مرة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצאו צורה, האזינו לה והתמקדו במשימה אחת בכל פעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक शेप खोजें, उसे सुनें और एक समय में एक काम पर ध्यान दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি শেপ খুঁজুন, শুনুন এবং একবারে একটি কাজে মন দিন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک شکل تلاش کریں، سنیں اور ایک وقت میں ایک کام پر توجہ دیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Temukan bentuk, dengarkan, dan fokus pada satu tugas setiap kali."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm một thế bấm, nghe thử và tập trung vào từng nhiệm vụ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหารูปแบบ ฟัง แล้วฝึกทีละงาน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォームを探して音を聴き、一度に一つの課題に集中しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운지를 찾고 들어 보며 한 번에 하나의 과제에 집중하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到一种指法，试听它，一次专注完成一项任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找到一種指法，試聽它，一次專注完成一項任務。"
          }
        }
      }
    },
