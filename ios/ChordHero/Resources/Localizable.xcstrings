    "Choose a traditional tune, set a comfortable tempo, and follow the progression one change at a time.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una canción tradicional, marca un tempo cómodo y sigue la progresión cambio a cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un air traditionnel, réglez un tempo confortable et suivez la progression changement par changement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein traditionelles Lied, stelle ein angenehmes Tempo ein und folge der Progression Schritt für Schritt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un brano tradizionale, imposta un tempo comodo e segui la progressione un cambio alla volta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma música tradicional, ajuste um andamento confortável e siga a progressão uma troca por vez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een traditioneel lied, stel een prettig tempo in en volg de progressie stap voor stap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tradycyjny utwór, ustaw wygodne tempo i śledź progresję krok po kroku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите народную песню, задайте удобный темп и проходите последовательность шаг за шагом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть традиційну пісню, задайте зручний темп і проходьте послідовність крок за кроком."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geleneksel bir parça seçin, rahat bir tempo belirleyin ve diziyi her seferinde bir geçiş izleyerek çalın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لحنًا تقليديًا واضبط إيقاعًا مريحًا واتبع التتابع انتقالًا تلو الآخر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מנגינה מסורתית, הגדירו קצב נוח ועקבו אחר הרצף מעבר אחר מעבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पारंपरिक धुन चुनें, सहज गति तय करें और हर बदलाव के साथ क्रम का अनुसरण करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ঐতিহ্যবাহী সুর বেছে নিন, আরামদায়ক গতি ঠিক করুন এবং ধাপে ধাপে প্রগ্রেশন অনুসরণ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "روایتی دھن چنیں، آرام دہ رفتار رکھیں اور ہر تبدیلی کے ساتھ ترتیب پر چلیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih lagu tradisional, atur tempo yang nyaman, lalu ikuti progresinya satu perpindahan demi satu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một giai điệu truyền thống, đặt nhịp độ thoải mái và theo tiến trình từng lần chuyển."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกเพลงดั้งเดิม ตั้งจังหวะที่สบาย แล้วตามลำดับคอร์ดทีละช่วง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伝統的な曲を選び、無理のないテンポを設定して、一つずつコード進行を追いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전통곡을 고르고 편안한 템포를 설정한 뒤 한 번에 한 전환씩 진행을 따라가세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一首传统曲目，设置舒适的速度，然后逐次跟随和弦进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一首傳統曲目，設定舒適的速度，然後逐次跟隨和弦進行。"
          }
        }
      }
    },
