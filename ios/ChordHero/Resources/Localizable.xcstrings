    "Generate theory or song charts, hear each shape, optimize transitions, and save an ordered practice sheet.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera tablas de teoría o canciones, escucha cada acorde, mejora las transiciones y guarda una hoja de práctica ordenada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez des tableaux de théorie ou de chansons, écoutez chaque position, optimisez les transitions et enregistrez une fiche ordonnée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle Theorie- oder Songdiagramme, höre jeden Griff an, verbessere Übergänge und speichere ein sortiertes Übungsblatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea tabelle teoriche o per brani, ascolta ogni posizione, ottimizza i passaggi e salva una scheda di pratica ordinata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere tabelas de teoria ou músicas, ouça cada posição, otimize as transições e salve uma folha de prática organizada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak theorie- of nummerschema’s, beluister elke greep, verbeter overgangen en bewaar een geordend oefenblad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz diagramy teorii lub utworów, odsłuchuj chwyty, usprawniaj przejścia i zapisuj uporządkowaną kartę ćwiczeń."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте схемы теории или песен, слушайте аккорды, улучшайте переходы и сохраняйте упорядоченный лист упражнений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте схеми теорії чи пісень, слухайте акорди, покращуйте переходи та зберігайте впорядкований аркуш вправ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teori veya şarkı tabloları oluşturun, şekilleri dinleyin, geçişleri iyileştirin ve sıralı bir çalışma sayfası kaydedin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ مخططات للنظرية أو الأغاني، واستمع إلى كل شكل، وحسّن الانتقالات، واحفظ ورقة تدريب مرتبة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צרו תרשימי תאוריה או שירים, האזינו לכל צורה, שפרו מעברים ושמרו דף תרגול מסודר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थ्योरी या गीत के चार्ट बनाएँ, हर शेप सुनें, बदलाव बेहतर करें और क्रमबद्ध अभ्यास शीट सहेजें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থিওরি বা গানের চার্ট তৈরি করুন, প্রতিটি শেপ শুনুন, পরিবর্তন উন্নত করুন এবং সাজানো অনুশীলনপত্র সংরক্ষণ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نظریے یا گانے کے چارٹ بنائیں، ہر شکل سنیں، تبدیلیاں بہتر کریں اور ترتیب وار مشقی شیٹ محفوظ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat bagan teori atau lagu, dengarkan setiap bentuk, optimalkan perpindahan, dan simpan lembar latihan yang terurut."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo sơ đồ lý thuyết hoặc bài hát, nghe từng thế bấm, tối ưu chuyển hợp âm và lưu phiếu luyện tập có thứ tự."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างแผนผังทฤษฎีหรือเพลง ฟังแต่ละรูปแบบ ปรับการเปลี่ยนคอร์ด และบันทึกใบฝึกที่เรียงลำดับแล้ว"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理論や曲のコード表を作成し、フォームを試聴し、チェンジを整え、順序付きの練習シートを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이론 또는 곡 차트를 만들고 각 운지를 들어 본 뒤 전환을 다듬고 정렬된 연습지를 저장하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成乐理或歌曲和弦图，试听每种指法，优化转换，并保存排序后的练习表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生樂理或歌曲和弦圖，試聽每種指法，最佳化轉換，並儲存排序後的練習表。"
          }
        }
      }
    },
    "Build a useful chart, then print only what you need.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una tabla útil e imprime solo lo que necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un tableau utile et n’imprimez que l’essentiel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein hilfreiches Diagramm und drucke nur, was du brauchst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una tabella utile e stampa solo ciò che serve."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma tabela útil e imprima somente o necessário."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een handig schema en druk alleen af wat je nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz przydatny diagram i drukuj tylko to, czego potrzebujesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте удобную схему и распечатайте только нужное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть корисну схему й друкуйте лише потрібне."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşe yarar bir akor tablosu oluşturun, yalnızca gerekeni yazdırın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ مخططًا مفيدًا واطبع ما تحتاج إليه فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צרו תרשים שימושי והדפיסו רק את מה שצריך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोगी चार्ट बनाएँ और केवल ज़रूरी चीज़ें प्रिंट करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাজের চার্ট তৈরি করুন, প্রয়োজনীয় অংশটুকুই প্রিন্ট করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مفید چارٹ بنائیں اور صرف ضروری چیز پرنٹ کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat bagan yang berguna dan cetak hanya yang diperlukan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo sơ đồ hữu ích và chỉ in phần bạn cần."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างแผนผังที่มีประโยชน์และพิมพ์เฉพาะสิ่งที่ต้องการ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使いやすいコード表を作り、必要なものだけ印刷できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유용한 차트를 만들고 필요한 것만 인쇄하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "制作实用的和弦图，只打印需要的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "製作實用的和弦圖，只列印需要的內容。"
          }
        }
      }
    },
