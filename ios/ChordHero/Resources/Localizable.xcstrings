    "Build a relaxed, even groove with downstrokes, upstrokes, accents, and mutes.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desarrolla un ritmo relajado y uniforme con golpes hacia abajo y arriba, acentos y silencios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construisez un rythme détendu et régulier avec des coups vers le bas et le haut, des accents et des silences."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickle einen lockeren, gleichmäßigen Groove mit Abschlägen, Aufschlägen, Akzenten und gedämpften Schlägen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci un groove rilassato e regolare con pennate in giù e in su, accenti e stoppate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um groove relaxado e constante com batidas para baixo e para cima, acentos e abafamentos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouw een ontspannen, gelijkmatige groove op met neer- en opwaartse slagen, accenten en dempingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbuduj swobodny, równy rytm, łącząc uderzenia w dół i w górę, akcenty oraz tłumienia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте свободный ровный ритм с ударами вниз и вверх, акцентами и приглушением."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте невимушений рівний ритм ударами вниз і вгору, акцентами та приглушеннями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağı ve yukarı vuruşları, vurguları ve susturmaları kullanarak rahat ve dengeli bir ritim kurun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابنِ إيقاعًا مريحًا ومتوازنًا بضربات إلى الأسفل والأعلى، مع التأكيدات وكتم الأوتار."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בנו גרוב נינוח ואחיד עם פריטות למטה ולמעלה, הדגשות והשתקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नीचे और ऊपर की स्ट्रमिंग, ज़ोर और म्यूट का उपयोग करके सहज, स्थिर ताल बनाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিচে ও ওপরে স্ট্রাম, জোর এবং মিউট ব্যবহার করে স্বচ্ছন্দ, সমান ছন্দ তৈরি করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نیچے اور اوپر کی اسٹرمنگ، زور اور تاروں کو خاموش کر کے پُرسکون، یکساں ردھم بنائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun groove santai dan merata dengan genjrengan turun-naik, aksen, dan mute."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo nhịp điệu thoải mái, đều đặn bằng cách quạt xuống, quạt lên, nhấn và chặn tiếng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างจังหวะที่ผ่อนคลายและสม่ำเสมอด้วยการตีลง ตีขึ้น เน้นจังหวะ และปิดเสียงสาย"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンとアップ、アクセント、ミュートを使って、力みのない安定したグルーヴを作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운·업 스트로크, 악센트, 뮤트를 사용해 편안하고 고른 그루브를 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用下扫、上扫、重音和闷音练出放松、均匀的律动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運用下刷、上刷、重音與悶音，培養放鬆而穩定的律動。"
          }
        }
      }
    },
