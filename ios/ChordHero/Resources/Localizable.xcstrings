    "Coordinate thumb and fingers through arpeggios, pinches, independence, and syncopation.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordina el pulgar y los dedos con arpegios, pellizcos, independencia y síncopas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordonnez le pouce et les doigts avec arpèges, pincements, indépendance et syncopes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordiniere Daumen und Finger mit Arpeggien, Doppelgriffen, Unabhängigkeit und Synkopen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordina pollice e dita con arpeggi, pizzichi, indipendenza e sincopi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Coordene polegar e dedos com arpejos, pinças, independência e síncopes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coördineer duim en vingers met arpeggio’s, knijpen, onafhankelijkheid en syncopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordynuj kciuk i palce, ćwicząc arpeggia, chwytanie, niezależność i synkopy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Координируйте большой палец и остальные пальцы в арпеджио, щипках, независимых движениях и синкопах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Координуйте великий та інші пальці в арпеджіо, щипках, незалежних рухах і синкопах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arpejler, çift sesler, bağımsızlık ve senkoplarla başparmak ve parmaklarınızı eşgüdümleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسّق حركة الإبهام والأصابع عبر الأربيجيو والقرص واستقلالية الأصابع والإيقاعات المتزامنة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאמו בין האגודל לאצבעות באמצעות ארפג'יו, צביטות, עצמאות וסינקופות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्पेजियो, पिंच, उँगलियों की स्वतंत्रता और सिंकोपेशन के साथ अंगूठे और उँगलियों का तालमेल बनाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর্পেজিও, পিঞ্চ, আঙুলের স্বাধীনতা ও সিনকোপেশনের মাধ্যমে বুড়ো আঙুল ও আঙুলের সমন্বয় করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آرپیجیو، چٹکی، انگلیوں کی آزادی اور سنکوپیشن سے انگوٹھے اور انگلیوں میں ہم آہنگی پیدا کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koordinasikan ibu jari dan jari melalui arpeggio, pinch, kemandirian jari, dan sinkopasi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phối hợp ngón cái và các ngón qua rải hợp âm, bấm chụm, độc lập ngón và đảo phách."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ประสานนิ้วโป้งและนิ้วอื่นผ่านอาร์เปจิโอ การดีดสองสาย ความเป็นอิสระของนิ้ว และซิงโคเปชัน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルペジオ、ピンチ、指の独立、シンコペーションを通して親指と指を連動させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아르페지오, 핀치, 손가락 독립, 싱코페이션을 통해 엄지와 손가락을 조화롭게 움직이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过琶音、双音拨弦、手指独立和切分节奏协调拇指与其他手指。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過琶音、雙音撥弦、手指獨立與切分節奏協調拇指和其他手指。"
          }
        }
      }
    },
