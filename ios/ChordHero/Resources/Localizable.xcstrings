    "Pick one practice mode and get straight to work.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una forma de practicar y ponte manos a la obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mode de pratique et commencez tout de suite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Übungsart und leg direkt los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un tipo di esercizio e inizia subito."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um modo de praticar e comece já."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een oefenvorm en ga meteen aan de slag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tryb ćwiczeń i od razu zacznij."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите режим практики и сразу переходите к делу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть режим занять і одразу до справи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çalışma modu seç ve hemen başla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نمطًا للتدريب وابدأ مباشرة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מצב אימון והתחילו מיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभ्यास का एक तरीका चुनें और तुरंत शुरू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি অনুশীলন পদ্ধতি বেছে নিয়ে এখনই শুরু করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مشق کا ایک انداز چنیں اور فوراً شروع کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih mode latihan dan langsung mulai."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một chế độ luyện tập và bắt đầu ngay."
          }
        },
        "th": {
