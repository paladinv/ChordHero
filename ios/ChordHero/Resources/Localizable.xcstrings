    "Follow guided strumming and picking drills.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue ejercicios guiados de rasgueo y punteo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez des exercices guidés de grattage et de picking."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge geführten Übungen für Strumming und Picking."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui esercizi guidati di strumming e picking."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga exercícios guiados de batida e palhetada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg begeleide oefeningen voor slag en picking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzystaj z ćwiczeń bicia i kostkowania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняйте упражнения на бой и перебор."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконуйте вправи на бій і перебір."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehberli ritim ve pena egzersizlerini izle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع تمارين الإيقاع والعزف بالريشة الموجّهة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחר תרגילי פריטה וליווי מודרכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्देशित स्ट्रमिंग और पिकिंग अभ्यास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্দেশিত স্ট্রামিং ও পিকিং অনুশীলন অনুসরণ করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رہنمائی کے ساتھ اسٹرمنگ اور پکنگ کی مشق کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti latihan genjrengan dan petikan terpandu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm theo bài tập quạt và gảy dây có hướng dẫn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำแบบฝึกตีคอร์ดและดีดสายตามคำแนะนำ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド付きのストロークとピッキングを練習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안내에 따라 스트로크와 피킹을 연습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随指导练习扫弦和拨弦。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟著指引練習刷弦與撥弦。"
          }
        }
      }
    },
    "Follow the motion, hear the technique, and build speed through short, measurable practice rounds.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue el movimiento, escucha la técnica y gana velocidad con rondas breves y medibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le mouvement, écoutez la technique et gagnez en vitesse grâce à de courtes séances mesurables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folge der Bewegung, höre auf die Technik und steigere dein Tempo in kurzen, messbaren Übungsrunden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui il movimento, ascolta la tecnica e aumenta la velocità con sessioni brevi e misurabili."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o movimento, ouça a técnica e ganhe velocidade em rodadas curtas e mensuráveis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg de beweging, luister naar de techniek en bouw snelheid op met korte, meetbare oefenrondes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podążaj za ruchem, słuchaj techniki i zwiększaj tempo w krótkich, mierzalnych rundach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следите за движением, слушайте технику и набирайте скорость в коротких измеримых раундах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стежте за рухом, слухайте техніку й набирайте швидкість у коротких вимірюваних раундах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketi izleyin, tekniği duyun ve kısa, ölçülebilir turlarla hız kazanın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتبع الحركة واستمع إلى التقنية وابنِ السرعة عبر جولات تدريب قصيرة قابلة للقياس."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקבו אחר התנועה, הקשיבו לטכניקה ובנו מהירות בסבבים קצרים ומדידים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गतियों का अनुसरण करें, तकनीक सुनें और छोटे, मापने योग्य राउंड से गति बढ़ाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নড়াচড়া অনুসরণ করুন, কৌশল শুনুন এবং ছোট, মাপযোগ্য রাউন্ডে গতি বাড়ান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "حرکت کے ساتھ چلیں، تکنیک سنیں اور مختصر، قابل پیمائش راؤنڈز میں رفتار بڑھائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti gerakan, dengarkan teknik, dan tingkatkan kecepatan lewat ronde singkat yang terukur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi chuyển động, lắng nghe kỹ thuật và tăng tốc qua các vòng ngắn có thể đo lường."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำตามการเคลื่อนไหว ฟังเทคนิค และเพิ่มความเร็วด้วยรอบฝึกสั้น ๆ ที่วัดผลได้"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動きを追い、テクニックを聴き、短く測定可能な練習でスピードを上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직임을 따라가고 기술을 들으며 짧고 측정 가능한 라운드로 속도를 높이세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随动作、聆听技巧，通过短而可衡量的练习回合逐步提速。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨動作、聆聽技巧，透過短而可衡量的練習回合逐步加速。"
          }
        }
      }
    },
