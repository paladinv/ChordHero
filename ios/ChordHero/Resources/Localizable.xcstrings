    "Practice ten chord changes with timed rounds.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica diez cambios de acordes en rondas cronometradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enchaînez dix changements d’accords en temps limité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe zehn Akkordwechsel in Runden mit Zeitlimit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati su dieci cambi di accordo a tempo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique dez trocas de acordes em rodadas cronometradas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen tien akkoordwissels in rondes met tijdslimiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz dziesięć zmian akordów w rundach na czas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируйте десять смен аккордов в раундах на время."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуйте десять змін акордів у раундах на час."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanlı turlarda on akor geçişi çalış."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب على عشرة انتقالات بين الأوتار في جولات محددة الوقت."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגלו עשרה מעברי אקורדים בסבבים מתוזמנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समयबद्ध राउंड में दस कॉर्ड बदलावों का अभ्यास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সময় ধরে দশটি কর্ড পরিবর্তনের অনুশীলন করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت والی مشقوں میں دس کورڈ تبدیلیاں کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih sepuluh perpindahan akor dalam ronde berwaktu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện mười lần chuyển hợp âm theo vòng có tính giờ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกเปลี่ยนคอร์ดสิบครั้งในรอบจับเวลา"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間制ラウンドで10回のコードチェンジを練習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간제 라운드에서 코드 전환 열 번을 연습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过计时回合练习十次和弦转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過計時回合練習十次和弦轉換。"
          }
        }
      }
    },
    "Build an adaptive round, mark each change honestly, and turn every miss into the next useful drill.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una ronda adaptable, evalúa cada cambio con sinceridad y convierte cada fallo en un ejercicio útil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une manche adaptative, évaluez honnêtement chaque changement et transformez chaque erreur en exercice utile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle eine adaptive Runde zusammen, bewerte jeden Wechsel ehrlich und mache aus jedem Fehler eine passende Übung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un turno adattivo, valuta con sincerità ogni cambio e trasforma ogni errore in un esercizio utile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte uma rodada adaptável, avalie cada troca com honestidade e transforme cada erro no próximo exercício útil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een adaptieve ronde samen, beoordeel elke wissel eerlijk en maak van elke misser een nuttige oefening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ułóż adaptacyjną rundę, uczciwie oceniaj każdą zmianę i zamieniaj błędy w kolejne przydatne ćwiczenie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соберите адаптивный раунд, честно оценивайте каждую смену и превращайте промахи в полезные упражнения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створіть адаптивний раунд, чесно оцінюйте кожну зміну й перетворюйте помилки на корисні вправи."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarlanabilir bir tur oluşturun, her geçişi dürüstçe değerlendirin ve her hatayı yararlı bir sonraki alıştırmaya dönüştürün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ جولة تكيفية، وقيّم كل انتقال بصدق، وحوّل كل خطأ إلى تمرين مفيد تالٍ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בנו סבב מסתגל, דרגו כל מעבר בכנות והפכו כל טעות לתרגיל הבא שיועיל לכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुकूल राउंड बनाएँ, हर बदलाव को ईमानदारी से आँकें और हर चूक को अगले उपयोगी अभ्यास में बदलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অভিযোজিত রাউন্ড তৈরি করুন, প্রতিটি পরিবর্তন সৎভাবে মূল্যায়ন করুন এবং ভুলকে পরের দরকারি অনুশীলনে বদলান।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مطابقت پذیر راؤنڈ بنائیں، ہر تبدیلی کو دیانت داری سے جانچیں اور ہر غلطی کو اگلی مفید مشق میں بدلیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat ronde adaptif, nilai setiap perpindahan dengan jujur, dan jadikan setiap kesalahan sebagai latihan berguna berikutnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo vòng tập thích ứng, đánh giá trung thực từng lần chuyển và biến mỗi lỗi thành bài tập hữu ích tiếp theo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างรอบฝึกแบบปรับตามผล ประเมินการเปลี่ยนแต่ละครั้งอย่างตรงไปตรงมา และเปลี่ยนทุกข้อผิดพลาดเป็นแบบฝึกที่มีประโยชน์ถัดไป"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適応型ラウンドを作り、各チェンジを正直に評価して、ミスを次の役立つ練習につなげます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적응형 라운드를 만들고 각 전환을 솔직하게 평가해 모든 실수를 다음 유용한 연습으로 바꾸세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建自适应回合，诚实评价每次转换，并把每次失误变成下一项有用练习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立自適應回合，誠實評估每次轉換，並把每次失誤變成下一項實用練習。"
          }
        }
      }
    },
    "Practice the transitions that need you most.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica los cambios que más necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaillez les transitions dont vous avez le plus besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe die Übergänge, die dich am meisten weiterbringen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esercitati sui passaggi di cui hai più bisogno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique as transições de que você mais precisa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen de overgangen die je het meest nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz przejścia, które najbardziej tego wymagają."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируйте переходы, которые важнее всего."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуйте переходи, які потрібні найбільше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En çok ihtiyaç duyduğunuz geçişleri çalışın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب على الانتقالات التي تحتاج إليها أكثر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגלו את המעברים שהכי יעזרו לכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन बदलावों का अभ्यास करें जिनकी आपको सबसे अधिक ज़रूरत है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে পরিবর্তনগুলো সবচেয়ে দরকার, সেগুলো অনুশীলন করুন।"
          }
