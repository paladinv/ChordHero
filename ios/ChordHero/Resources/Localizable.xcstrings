          "stringUnit": {
            "state": "translated",
            "value": "Zaplanuj ćwiczenie akordów, utworów i rytmu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планируйте занятия по аккордам, песням и ритму."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
