    "Explore chords, save shapes, and review.": {
      "comment": "Generated from the shared Chord Hero localization catalog.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora acordes, guarda posiciones y repasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez les accords, enregistrez des positions et révisez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke Akkorde, speichere Griffe und wiederhole."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora accordi, salva le posizioni e ripassa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore acordes, salve posições e revise."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek akkoorden, bewaar grepen en herhaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznawaj akordy, zapisuj chwyty i powtarzaj."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изучайте аккорды, сохраняйте аппликатуры и повторяйте."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчайте акорди, зберігайте аплікатури й повторюйте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akorları keşfet, şekilleri kaydet ve tekrar et."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف الأوتار واحفظ الأشكال وراجعها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גלו אקורדים, שמרו צורות וחזרו עליהן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉर्ड देखें, शेप सहेजें और दोहराएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কর্ড দেখুন, শেপ সংরক্ষণ করুন ও পুনরাবৃত্তি করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کورڈ دیکھیں، شکلیں محفوظ کریں اور دہرائیں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi akor, simpan bentuk, dan ulangi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khám phá hợp âm, lưu thế bấm và ôn tập."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรวจคอร์ด บันทึกรูปแบบ และทบทวน"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを探し、フォームを保存して復習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 살펴보고 운지를 저장해 복습하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探索和弦，保存指法并复习。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "探索和弦、儲存指法並複習。"
          }
        }
      }
    },
