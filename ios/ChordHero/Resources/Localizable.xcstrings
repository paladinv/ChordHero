            "state": "translated",
            "value": "Создавайте, слушайте и экспортируйте аранжировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створюйте, слухайте й експортуйте аранжування."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aranjmanlarını yaz, dinle ve dışa aktar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب توزيعاتك واسمعها وصدّرها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבו, האזינו וייצאו את העיבודים שלכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी अरेंजमेंट लिखें, सुनें और निर्यात करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যারেঞ্জমেন্ট লিখুন, শুনুন ও রপ্তানি করুন।"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی ترتیب لکھیں، سنیں اور برآمد کریں۔"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis, dengarkan, dan ekspor aransemenmu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết, nghe thử và xuất bản phối của bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เขียน ฟังตัวอย่าง และส่งออกการเรียบเรียง"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アレンジを作成、試聴、書き出しできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편곡을 작성하고 미리 듣고 내보내세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
