            "value": "Akor, şarkı ve ritim çalışmalarını planla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطط لتدريب الأوتار والأغاني والإيقاع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תכננו אימון של אקורדים, שירים וקצב."
