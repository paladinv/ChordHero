{
  "name": "chord-hero",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sync-server": "node server/syncServer.mjs",
    "lint": "next lint",
    "content:export": "node scripts/export-shared-content.mjs",
    "content:validate": "node scripts/validate-shared-content.mjs",
    "localization:generate": "node scripts/localization.mjs",
    "localization:validate": "node scripts/localization.mjs --validate",
    "harmony:validate": "node --experimental-strip-types scripts/validate-harmony.mjs",
    "guitar3d:validate": "npm run test:web:guitar3d:math && npm run test:web:guitar3d:assets",
    "song-library:compatibility": "node --experimental-strip-types scripts/validate-song-library-compatibility.mjs",
    "ci:performance": "node scripts/check-performance-budget.mjs",
    "ci:visual": "node scripts/check-visual-regression.mjs",
    "ci:quality": "node scripts/test-groups.mjs all",
    "test:changed": "node scripts/test-groups.mjs changed",
    "test:groups": "node scripts/test-groups.mjs groups",
    "test:all": "node scripts/test-groups.mjs all",
    "test:web:content": "npm run content:validate && node tests/web/chord-quality-catalog.test.mjs && node tests/web/content-export.test.mjs",
    "test:web:harmony": "npm run harmony:validate",
    "test:web:guitar3d:math": "node --experimental-strip-types scripts/validate-guitar-technique3d.mjs",
    "test:web:guitar3d:assets": "node --experimental-strip-types scripts/validate-guitar-technique3d-assets.mjs",
    "test:web:library-search": "node --experimental-strip-types scripts/validate-library-search-safety.mjs",
    "test:web:chord-library": "node --experimental-strip-types tests/web/chord-library-workflow.test.mjs && node scripts/validate-chord-library-workspace.mjs",
    "test:web:chart-arrangement": "node --experimental-strip-types tests/web/chord-chart-arrangement.test.mjs",
    "test:web:chord-chart-pitch": "node --experimental-strip-types tests/web/chord-chart-pitch.test.mjs",
    "test:web:chord-chart-shape": "node --experimental-strip-types tests/web/chord-chart-shape.test.mjs",
    "test:web:chord-chart-learning": "node --experimental-strip-types tests/web/chord-chart-learning.test.mjs",
    "test:web:chord-chart-enhancements": "node --experimental-strip-types tests/web/chord-chart-enhancements.test.mjs",
    "test:web:chord-chart-deep-tools": "node --experimental-strip-types tests/web/chord-chart-deep-tools.test.mjs",
    "test:web:song-library": "node --experimental-strip-types scripts/validate-song-library-compatibility.mjs",
    "test:web:localization": "npm run localization:validate",
    "test:web:types": "tsc --noEmit --incremental false",
    "test:web:build-performance": "npm run build && npm run ci:performance",
    "test:web:runner": "node --test tests/test-groups.test.mjs",
    "test:android:unit": "node scripts/run-android-tests.mjs unit",
    "test:android:instrumented": "node scripts/run-android-tests.mjs instrumented",
    "test:ios:unit": "node scripts/run-ios-tests.mjs unit",
    "test:ios:ui": "node scripts/run-ios-tests.mjs ui",
    "test:visual": "npm run ci:visual",
    "test:web:song-builder": "node scripts/validate-song-builder.mjs",
    "test:web:chord-chart-arrangement": "node --experimental-strip-types scripts/validate-chord-chart-arrangement.mjs",
    "test:web:right-hand-learning": "node scripts/validate-right-hand-learning.mjs && node scripts/validate-right-hand-followups.mjs",
    "test:web:right-hand-audio": "node scripts/validate-right-hand-audio-evidence.mjs && node scripts/validate-right-hand-review-controls.mjs",
    "test:web:trainer-adaptive": "node tests/web/trainer-adaptive.test.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "source-map-js": "^1.2.0",
    "three": "^0.185.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.185.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "typescript": "^5.4.5"
  }
}
