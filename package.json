    "ci:performance": "node scripts/check-performance-budget.mjs",
    "ci:visual": "node scripts/check-visual-regression.mjs",
    "ci:quality": "npm run content:validate && npm run build && npm run ci:performance && npm run ci:visual"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
